<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calendrier public</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css?v=20260611d" />
  </head>
  <body
    class="reservation-public-body"
    data-public-timezone="<%= timezonePublique %>"
    data-public-timezone-label="<%= timezonePubliqueLabel %>"
    data-central-timezone-label="<%= timezoneCentraleLabel %>"
  >
    <main class="reservation-public-main">
      <section class="reservation-public-shell">
        <header class="panel reservation-public-toolbar">
          <div>
            <p class="reservation-public-eyebrow">Calendrier public</p>
            <h1>Planning SuperProf</h1>
          </div>

          <div class="reservation-public-actions">
            <span class="reservation-public-timezone"><%= timezonePubliqueLabel %></span>
            <span
              id="reservation-public-updated-at"
              class="reservation-public-sync"
              aria-live="polite"
            >
              Synchronisation active
            </span>
          </div>
        </header>

        <section class="panel reservation-public-calendar-panel">
          <div class="reservation-public-calendar-head">
            <div class="reservation-public-legend" aria-label="Légende">
              <span class="reservation-public-legend-item">
                <span class="reservation-public-legend-swatch reservation-public-legend-swatch-blocked"></span>
                Créneaux occupés
              </span>
            </div>
          </div>

          <div id="reservation-public-error" class="form-error hidden"></div>
          <div id="reservation-public-calendar" class="reservation-public-calendar"></div>
        </section>
      </section>
    </main>

    <script src="/vendor/@fullcalendar/core/index.global.js"></script>
    <script src="/vendor/@fullcalendar/core/locales-all.global.js"></script>
    <script src="/vendor/@fullcalendar/daygrid/index.global.js"></script>
    <script src="/vendor/@fullcalendar/timegrid/index.global.js"></script>
    <script src="/vendor/@fullcalendar/interaction/index.global.js"></script>
    <script type="module" src="/js/public-reservation.js?v=20260519a"></script>
  </body>
</html>
