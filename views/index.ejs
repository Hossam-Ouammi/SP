<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestion des séances</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#164fdc" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Séances" />
    <link rel="manifest" href="/manifest.webmanifest?v=20260403a" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="/css/style.css?v=20260611d" />
  </head>
  <body>
    <main>
      <section id="login-view" class="page login-page<%= user ? " hidden" : "" %>">
        <div class="login-shell">
          <div class="panel login-card">
            <div class="login-header">
              <div class="login-brand">Gestion des séances</div>
              <h1>Connexion</h1>
              <p>Accès partagé pour les deux utilisateurs.</p>
            </div>

            <noscript>
              <p class="form-error">
                JavaScript est requis pour utiliser l'application après la connexion.
              </p>
            </noscript>

            <form id="login-form" class="stack-form" method="post" action="/">
              <label class="field">
                <span>Identifiant</span>
                <input
                  id="login-username"
                  name="username"
                  type="text"
                  placeholder="Votre identifiant"
                  autocomplete="username"
                  value="<%= loginUsername || "" %>"
                  required
                />
              </label>

              <label class="field">
                <span>Mot de passe</span>
                <input
                  id="login-password"
                  name="mot_de_passe"
                  type="password"
                  placeholder="Votre mot de passe"
                  autocomplete="current-password"
                  required
                />
              </label>

              <div class="login-options">
                <label class="inline-option">
                  <input id="login-show-password" type="checkbox" />
                  <span>Afficher le mot de passe</span>
                </label>

                <label class="inline-option">
                  <input id="login-remember" name="remember_device" type="checkbox" />
                  <span>Entrer directement sur cet appareil</span>
                </label>
              </div>

              <p id="login-error" class="form-error<%= loginError ? "" : " hidden" %>">
                <%= loginError || "" %>
              </p>

              <button id="login-button" class="button primary full-width" type="submit">
                Se connecter
              </button>
            </form>

          </div>
        </div>
      </section>

      <section id="app-view" class="page app-page<%= user ? "" : " hidden" %>">
        <header class="topbar panel">
          <div class="topbar-left">
            <h1 class="brand-title">Gestion des séances</h1>
            <div class="topbar-meta">
              <span class="user-pill" id="current-user-name">Utilisateur</span>
            </div>
          </div>

          <div class="topbar-actions">
            <button id="add-seance-button" class="button primary" type="button">
              Ajouter
            </button>
            <button id="logout-button" class="button secondary" type="button">
              Déconnexion
            </button>
          </div>
        </header>

        <nav class="workspace-nav panel">
          <button class="nav-tab hidden" type="button" data-section-target="aujourdhui">
            Aujourd'hui
          </button>
          <button class="nav-tab" type="button" data-section-target="dashboard">
            Dashboard
          </button>
          <button class="nav-tab hidden" type="button" data-section-target="indisponibilites">
            Indisponibilités
          </button>
          <button class="nav-tab" type="button" data-section-target="statistiques">
            Statistiques
          </button>
          <button class="nav-tab hidden" type="button" data-section-target="monetisation">
            Monétisation
          </button>
          <button class="nav-tab" type="button" data-section-target="historique">
            Historique
          </button>
          <button class="nav-tab" type="button" data-section-target="utilisateur">
            User admin
          </button>
        </nav>

        <section id="aujourdhui-section" class="app-section">
          <section class="panel today-panel">
            <div class="section-heading section-heading-stack">
              <div>
                <h2>Aujourd'hui</h2>
                <p id="today-date-label" class="section-note">-</p>
              </div>
              <span id="today-count" class="history-count">0</span>
            </div>

            <div id="today-list" class="today-agenda"></div>
          </section>
        </section>

        <section id="dashboard-section" class="app-section hidden">
          <section class="panel calendar-panel">
            <div class="section-heading">
              <h2>Calendrier</h2>
            </div>

            <div id="calendar"></div>
          </section>
        </section>

        <section id="indisponibilites-section" class="app-section hidden">
          <section class="panel admin-panel-shell">
            <div class="section-heading section-heading-stack">
              <div>
                <h2>Indisponibilités</h2>
                <p class="section-note">
                  Déclare ici les créneaux non disponibles. Aucune séance ne pourra être ajoutée sur
                  ces horaires.
                </p>
              </div>
            </div>

            <nav class="unavailability-workbench-nav" aria-label="Vues des indisponibilités">
              <button
                class="admin-workbench-tab is-active"
                type="button"
                data-unavailability-view="declaration"
              >
                Déclaration
              </button>
              <button
                id="unavailability-propositions-tab"
                class="admin-workbench-tab"
                type="button"
                data-unavailability-view="propositions"
              >
                <span>Propositions</span>
                <span
                  id="unavailability-propositions-badge"
                  class="menu-notification-badge hidden"
                  aria-hidden="true"
                ></span>
              </button>
            </nav>

            <div
              id="unavailability-declaration-panel"
              class="unavailability-workbench-panel"
              data-unavailability-panel="declaration"
            >
              <section class="admin-card unavailability-calendar-card">
                <div class="admin-card-head">
                  <div>
                    <h3 class="user-form-title">Déclaration</h3>
                  </div>
                </div>

                <div id="unavailability-calendar"></div>
              </section>
            </div>

            <div
              id="unavailability-propositions-panel"
              class="unavailability-workbench-panel hidden"
              data-unavailability-panel="propositions"
            >
              <article class="admin-card admin-directory-card">
                <div class="admin-card-head">
                  <div>
                    <h3 class="user-form-title">Propositions</h3>
                    <p class="section-note">
                      Valide, refuse ou ajuste les demandes qui tombent sur un créneau bloqué.
                    </p>
                  </div>
                </div>

                <div id="admin-unavailability-list" class="admin-session-list"></div>
              </article>
            </div>
          </section>
        </section>

        <section id="statistiques-section" class="app-section hidden">
          <div id="stats-accounts-overview" class="statistics-overview-grid">
            <article class="panel stat-overview-card stat-overview-card-primary">
              <span class="stat-overview-label">Total general</span>
              <strong id="total-count" class="stat-overview-value">0</strong>
            </article>

            <article class="panel stat-overview-card">
              <span class="stat-overview-label">Compte Yassine</span>
              <strong id="stats-yassine-total" class="stat-overview-value">0</strong>
            </article>

            <article class="panel stat-overview-card">
              <span class="stat-overview-label">Compte Abdo</span>
              <strong id="stats-abdo-total" class="stat-overview-value">0</strong>
            </article>
          </div>

          <section class="panel stats-compare-panel">
            <div class="section-heading section-heading-stack">
              <div>
                <h2>Comparatif direct</h2>
                <p class="section-note">Les indicateurs essentiels, séparés par compte.</p>
              </div>
            </div>

            <div id="stats-accounts-table" class="stats-table">
              <div class="stats-table-row stats-table-head">
                <span>Indicateur</span>
                <strong>Yassine</strong>
                <strong>Abdo</strong>
              </div>

              <div class="stats-table-row">
                <span>Planifiées</span>
                <strong id="stats-yassine-planned">0</strong>
                <strong id="stats-abdo-planned">0</strong>
              </div>

              <div class="stats-table-row">
                <span>Faites</span>
                <strong id="stats-yassine-completed">0</strong>
                <strong id="stats-abdo-completed">0</strong>
              </div>

              <div class="stats-table-row stats-table-row-muted stats-table-row-sub">
                <span class="stats-table-label-sub">Séances d'essai</span>
                <strong id="stats-yassine-completed-trial">0</strong>
                <strong id="stats-abdo-completed-trial">0</strong>
              </div>

              <div class="stats-table-row stats-table-row-muted stats-table-row-sub">
                <span class="stats-table-label-sub">Séances standard</span>
                <strong id="stats-yassine-completed-regular">0</strong>
                <strong id="stats-abdo-completed-regular">0</strong>
              </div>

              <div class="stats-table-row">
                <span>Reportées</span>
                <strong id="stats-yassine-postponed">0</strong>
                <strong id="stats-abdo-postponed">0</strong>
              </div>

              <div class="stats-table-row">
                <span>Annulées</span>
                <strong id="stats-yassine-cancelled">0</strong>
                <strong id="stats-abdo-cancelled">0</strong>
              </div>
            </div>
          </section>
        </section>

        <section id="utilisateur-section" class="app-section hidden">
          <section class="panel admin-panel-shell">
            <div class="section-heading section-heading-stack">
              <div>
                <h2 id="admin-panel-title">User admin</h2>
                <p id="admin-panel-note" class="section-note">
                  Sécurité du compte et outils utilisateur.
                </p>
              </div>
            </div>

            <section class="admin-overview-strip">
              <article class="admin-identity-card">
                <div class="admin-identity-head">
                  <div>
                    <span class="summary-label">Compte connecté</span>
                    <strong id="user-username" class="summary-value user-summary-value">-</strong>
                  </div>

                  <div class="admin-identity-badges">
                    <span id="user-role-badge" class="admin-status-badge">
                      User
                    </span>
                    <span
                      id="user-access-badge"
                      class="admin-status-badge admin-status-badge-active"
                    >
                      Actif
                    </span>
                  </div>
                </div>

                <p id="user-security-status" class="user-security-status">Compte sécurisé.</p>

                <div class="admin-identity-stats">
                  <div class="admin-identity-stat">
                    <span>Outils sensibles</span>
                    <strong id="user-admin-access">Non</strong>
                  </div>
                  <div class="admin-identity-stat">
                    <span>Dernière connexion</span>
                    <strong id="user-last-login">-</strong>
                  </div>
                </div>
              </article>

              <article class="admin-guide-card">
                <span class="summary-label">Vue rapide</span>
                <strong id="admin-guide-title" class="admin-guide-title">Sécurité et contrôle</strong>
                <p id="admin-guide-note" class="section-note">
                  Le mot de passe se modifie ici. Les actions avancées sont réservées à
                  Hossam et demandent toujours son mot de passe actuel.
                </p>
              </article>
            </section>

            <div class="admin-panel-layout">
              <form
                id="user-password-form"
                class="stack-form user-password-form admin-card admin-password-card"
                data-admin-group="password"
              >
                <div class="admin-card-head">
                  <div>
                    <h3 class="user-form-title">Sécurité du compte</h3>
                    <p class="section-note">
                      Modifiez votre mot de passe depuis cet espace.
                    </p>
                  </div>
                </div>

                <div class="admin-card-body stack-form">
                  <div id="password-security-notice" class="security-notice hidden">
                    Changez le mot de passe maintenant pour débloquer l'application.
                  </div>

                  <label class="field">
                    <span>Mot de passe actuel</span>
                    <input
                      id="current-password"
                      name="mot_de_passe_actuel"
                      type="password"
                      autocomplete="current-password"
                      required
                    />
                  </label>

                  <label class="field">
                    <span>Nouveau mot de passe</span>
                    <input
                      id="new-password"
                      name="nouveau_mot_de_passe"
                      type="password"
                      minlength="12"
                      autocomplete="new-password"
                      required
                    />
                  </label>

                  <label class="field">
                    <span>Confirmer le nouveau mot de passe</span>
                    <input
                      id="confirm-password"
                      name="confirmation_mot_de_passe"
                      type="password"
                      minlength="12"
                      autocomplete="new-password"
                      required
                    />
                  </label>

                  <p class="user-password-help">
                    12 caractères minimum avec minuscule, majuscule, chiffre et caractère spécial.
                  </p>

                  <p id="user-password-error" class="form-error hidden"></p>

                  <div class="form-actions">
                    <button id="save-password-button" class="button primary" type="submit">
                      Modifier le mot de passe
                    </button>
                  </div>
                </div>
              </form>

              <section id="admin-tools-panel" class="user-admin-shell hidden">
                <nav class="admin-workbench-nav" aria-label="Navigation admin">
                  <button
                    class="admin-workbench-tab is-active"
                    type="button"
                    data-admin-view="accounts"
                    aria-selected="true"
                  >
                    Comptes
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="catalogue">
                    Catalogue
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="access">
                    Accès
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="security">
                    Sécurité
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="password">
                    MDP
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="notifications">
                    Notifications
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="maintenance">
                    Maintenance
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="danger">
                    Zone critique
                  </button>
                </nav>

                <article class="admin-card admin-directory-card" data-admin-group="accounts">
                  <div class="admin-card-head">
                    <div>
                      <h3 class="user-form-title">Utilisateurs</h3>
                      <p class="section-note">
                        Ajoutez des comptes et suivez leur état en un seul endroit.
                      </p>
                    </div>
                  </div>

                  <div class="admin-summary-strip">
                    <div class="admin-summary-tile">
                      <span>Total comptes</span>
                      <strong id="admin-total-users">0</strong>
                    </div>
                    <div class="admin-summary-tile">
                      <span>Actifs</span>
                      <strong id="admin-active-users">0</strong>
                    </div>
                    <div class="admin-summary-tile">
                      <span>Lecture seule</span>
                      <strong id="admin-readonly-users">0</strong>
                    </div>
                    <div class="admin-summary-tile">
                      <span>Sessions actives</span>
                      <strong id="admin-active-sessions">0</strong>
                    </div>
                  </div>

                  <div id="admin-users-list" class="admin-user-list"></div>
                </article>

                <article class="admin-card admin-actions-shell" data-admin-group-shell>
                  <div class="admin-card-head">
                    <div>
                      <h3 id="admin-actions-title" class="user-form-title">Outils de gestion</h3>
                      <p id="admin-actions-note" class="section-note">
                        Chaque action sensible demande votre mot de passe actuel.
                      </p>
                    </div>
                  </div>

                  <div class="admin-actions-grid">
                    <form
                      id="admin-add-account-form"
                      class="stack-form user-password-form user-admin-form admin-action-card"
                      data-admin-group="catalogue"
                    >
                      <div>
                        <h3 class="user-form-title">Ajouter un compte</h3>
                        <p class="section-note">
                          Ajoute un compte de travail disponible dans les séances.
                        </p>
                      </div>

                      <label class="field">
                        <span>Nom du compte</span>
                        <input id="admin-new-account-name" type="text" maxlength="80" required />
                      </label>

                      <div id="admin-account-list" class="admin-catalog-list"></div>

                      <label class="field">
                        <span>Votre mot de passe actuel</span>
                        <input
                          id="admin-add-account-current-password"
                          type="password"
                          autocomplete="current-password"
                          required
                        />
                      </label>

                      <p id="admin-add-account-error" class="form-error hidden"></p>

                      <div class="form-actions">
                        <button id="admin-add-account-button" class="button primary" type="submit">
                          Ajouter le compte
                        </button>
                      </div>
                    </form>

                    <form
                      id="admin-create-user-form"
                      class="stack-form user-password-form user-admin-form admin-action-card"
                      data-admin-group="accounts"
                    >
                      <div>
                        <h3 class="user-form-title">Ajouter un utilisateur</h3>
                        <p class="section-note">
                          Le nouveau compte demarre avec un code temporaire unique et devra le changer.
                        </p>
                      </div>

                      <label class="field">
                        <span>Nom d'utilisateur</span>
                        <input
                          id="admin-new-user-name"
                          type="text"
                          maxlength="60"
                          autocomplete="username"
                          required
                        />
                      </label>

                      <label class="field">
                        <span>Email</span>
                        <input
                          id="admin-new-user-email"
                          type="email"
                          maxlength="160"
                          autocomplete="email"
                          required
                        />
                      </label>

                      <label class="field">
                        <span>Votre mot de passe actuel</span>
                        <input
                          id="admin-create-user-current-password"
                          type="password"
                          autocomplete="current-password"
                          required
                        />
                      </label>

                      <p id="admin-create-user-error" class="form-error hidden"></p>
                      <div
                        id="admin-create-user-result"
                        class="security-notice security-notice-success hidden"
                      ></div>

                      <div class="form-actions">
                        <button id="admin-create-user-button" class="button primary" type="submit">
                          Ajouter l'utilisateur
                        </button>
                      </div>
                    </form>

                    <form
                      id="admin-delete-user-form"
                      class="stack-form user-password-form user-admin-form admin-action-card"
                      data-admin-group="accounts danger"
                    >
                      <div>
                        <h3 class="user-form-title">Supprimer un utilisateur</h3>
                        <p class="section-note">
                          Supprime le compte cible et coupe immediatement toutes ses sessions.
                        </p>
                      </div>

                      <label class="field">
                        <span>Compte cible</span>
                        <select id="admin-delete-user-id" required></select>
                      </label>

                      <label class="field">
                        <span>Votre mot de passe actuel</span>
                        <input
                          id="admin-delete-user-current-password"
                          type="password"
                          autocomplete="current-password"
                          required
                        />
                      </label>

                      <p id="admin-delete-user-error" class="form-error hidden"></p>

                      <div class="form-actions">
                        <button id="admin-delete-user-button" class="button danger" type="submit">
                          Supprimer l'utilisateur
                        </button>
                      </div>
                    </form>

                    <form
                      id="admin-reset-password-form"
                      class="stack-form user-password-form user-admin-form admin-action-card"
                      data-admin-group="accounts"
                    >
                      <div>
                        <h3 class="user-form-title">Réinitialiser un mot de passe</h3>
                        <p class="section-note">
                          Génère un code temporaire unique. Pense à le copier : il ne sera pas stocké en clair.
                        </p>
                      </div>

                      <label class="field">
                        <span>Compte cible</span>
                        <select id="admin-reset-user-id" required></select>
                      </label>

                      <label class="field">
                        <span>Votre mot de passe actuel</span>
                        <input
                          id="admin-reset-current-password"
                          type="password"
                          autocomplete="current-password"
                          required
                        />
                      </label>

                      <p id="admin-reset-password-error" class="form-error hidden"></p>
                      <div
                        id="admin-reset-password-result"
                        class="security-notice security-notice-success hidden"
                      ></div>

                      <div class="form-actions">
                        <button
                          id="admin-reset-password-button"
                          class="button danger"
                          type="submit"
                        >
                          Réinitialiser le mot de passe
                        </button>
                      </div>
                    </form>

                    <form
                      id="admin-toggle-access-form"
                      class="stack-form user-password-form user-admin-form admin-action-card"
                      data-admin-group="access"
                    >
                      <div>
                        <h3 class="user-form-title">Gérer l'accès</h3>
                        <p class="section-note">
                          Suspendez ou réactivez un compte collaborateur.
                        </p>
                      </div>

                      <label class="field">
                        <span>Compte cible</span>
                        <select id="admin-access-user-id" required></select>
                      </label>

                      <div class="security-notice security-notice-subtle">
                        État actuel : <strong id="admin-toggle-access-status">-</strong>
                      </div>

                      <label class="field">
                        <span>Votre mot de passe actuel</span>
                        <input
                          id="admin-toggle-access-current-password"
                          type="password"
                          autocomplete="current-password"
                          required
                        />
                      </label>

                      <p id="admin-toggle-access-error" class="form-error hidden"></p>

                      <div class="form-actions">
                        <button
                          id="admin-toggle-access-button"
                          class="button secondary"
                          type="submit"
                        >
                          Mettre à jour l'accès
                        </button>
                      </div>
                    </form>

                    <form
                      id="admin-readonly-form"
                      class="stack-form user-password-form user-admin-form admin-action-card"
                      data-admin-group="access"
                    >
                      <div>
                        <h3 class="user-form-title">Lecture seule</h3>
                        <p class="section-note">
                          Autorisez la consultation seule sans modification.
                        </p>
                      </div>

                      <label class="field">
                        <span>Compte cible</span>
                        <select id="admin-readonly-user-id" required></select>
                      </label>

                      <div class="security-notice security-notice-subtle">
                        État actuel : <strong id="admin-readonly-status">-</strong>
                      </div>

                      <label class="field">
                        <span>Votre mot de passe actuel</span>
                        <input
                          id="admin-readonly-current-password"
                          type="password"
                          autocomplete="current-password"
                          required
                        />
                      </label>

                      <p id="admin-readonly-error" class="form-error hidden"></p>

                      <div class="form-actions">
                        <button id="admin-readonly-button" class="button secondary" type="submit">
                          Mettre à jour le mode
                        </button>
                      </div>
                    </form>

                    <form
                      id="admin-today-form"
                      class="stack-form user-password-form user-admin-form admin-action-card"
                      data-admin-group="access"
                    >
                      <div>
                        <h3 class="user-form-title">Afficher Aujourd'hui</h3>
                        <p class="section-note">
                          Autorise ou masque le menu Aujourd'hui pour le compte cible.
                        </p>
                      </div>

                      <label class="field">
                        <span>Compte cible</span>
