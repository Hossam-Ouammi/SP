<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestion des séances</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#164fdc" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Séances" />
    <link rel="manifest" href="/manifest.webmanifest?v=20260403a" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="/css/style.css?v=20260911-calendar-background-fix" />
  </head>
  <body>
    <main>
      <section id="login-view" class="page login-page<%= user ? " hidden" : "" %>">
        <div class="login-shell">
          <div class="panel login-card">
            <div class="login-header">
              <div class="login-brand">Gestion des séances</div>
              <h1>Connexion</h1>
            </div>

            <noscript>
              <p class="form-error">
                JavaScript est requis pour utiliser l'application après la connexion.
              </p>
            </noscript>

            <form id="login-form" class="stack-form" method="post" action="/">
              <label class="field">
                <span>Identifiant</span>
                <input
                  id="login-username"
                  name="username"
                  type="text"
                  placeholder="Votre identifiant"
                  autocomplete="username"
                  value="<%= loginUsername || "" %>"
                  required
                />
              </label>

              <label class="field">
                <span>Mot de passe</span>
                <input
                  id="login-password"
                  name="mot_de_passe"
                  type="password"
                  placeholder="Votre mot de passe"
                  autocomplete="current-password"
                  required
                />
              </label>

              <div class="login-options">
                <label class="inline-option">
                  <input id="login-show-password" type="checkbox" />
                  <span>Afficher le mot de passe</span>
                </label>

                <label class="inline-option">
                  <input id="login-remember" name="remember_device" type="checkbox" />
                  <span>Entrer directement sur cet appareil</span>
                </label>
              </div>

              <p id="login-error" class="form-error<%= loginError ? "" : " hidden" %>">
                <%= loginError || "" %>
              </p>

              <button id="login-button" class="button primary full-width" type="submit">
                Se connecter
              </button>
            </form>

            <div class="login-lifecycle-actions" aria-label="Accès au cycle de compte">
              <button id="show-account-request-button" class="button link-button" type="button">
                Création de compte
              </button>
              <button id="show-password-reset-button" class="button link-button" type="button">
                Récupérer mot de passe
              </button>
            </div>

            <form id="account-request-form" class="stack-form login-secondary-form hidden" novalidate>
              <h2>Création de compte</h2>
              <label class="field">
                <span>Nom</span>
                <input id="account-request-name" name="nom" type="text" maxlength="120" autocomplete="name" required />
              </label>
              <label class="field">
                <span>Email</span>
                <input id="account-request-email" name="email" type="email" maxlength="160" autocomplete="email" required />
              </label>
              <label class="field">
                <span>Type de compte</span>
                <select id="account-request-role" name="role" required>
                  <option value="professeur">Professeur</option>
                  <option value="handler">Handler</option>
                </select>
              </label>
              <label id="account-request-handler-field" class="field">
                <span>Identifiant Handler</span>
                <select id="account-request-handler" name="handler_public_id"></select>
              </label>
              <p id="account-request-error" class="form-error hidden"></p>
              <div id="account-request-notification" class="form-notice success hidden" role="status" aria-live="polite"></div>
              <button class="button primary full-width" type="submit">Envoyer la demande</button>
              <button class="button secondary full-width login-return-button" type="button" data-login-lifecycle-back>
                Retour à la connexion
              </button>
            </form>

            <form id="password-reset-request-form" class="stack-form login-secondary-form hidden" novalidate>
              <h2>Récupérer mot de passe</h2>
              <label class="field">
                <span>Email</span>
                <input id="password-reset-identifier" name="email" type="email" maxlength="160" autocomplete="email" required />
              </label>
              <p id="password-reset-request-error" class="form-error hidden"></p>
              <div id="password-reset-notification" class="form-notice success hidden" role="status" aria-live="polite"></div>
              <button id="password-reset-submit-button" class="button primary full-width" type="submit">Récupérer</button>
              <button class="button secondary full-width login-return-button" type="button" data-login-lifecycle-back>
                Retour à la connexion
              </button>
            </form>

            <form id="account-token-form" class="stack-form login-secondary-form hidden" novalidate>
              <h2 id="account-token-title">Définir votre mot de passe</h2>
              <label class="field">
                <span>Nouveau mot de passe</span>
                <input id="account-token-password" type="password" minlength="12" autocomplete="new-password" required />
              </label>
              <label class="field">
                <span>Confirmer le mot de passe</span>
                <input id="account-token-password-confirmation" type="password" minlength="12" autocomplete="new-password" required />
              </label>
              <label class="inline-option login-password-visibility-option">
                <input id="account-token-show-password" type="checkbox" />
                <span>Afficher les mots de passe</span>
              </label>
              <p id="account-token-error" class="form-error hidden"></p>
              <div id="account-token-notification" class="form-notice success hidden" role="status" aria-live="polite"></div>
              <button class="button primary full-width" type="submit">Enregistrer le mot de passe</button>
              <button class="button secondary full-width login-return-button" type="button" data-login-lifecycle-back>
                Retour à la connexion
              </button>
            </form>

          </div>
        </div>
      </section>

      <section id="app-view" class="page app-page<%= user ? "" : " hidden" %>">
        <header class="topbar panel">
          <div class="topbar-left">
            <h1 class="brand-title">Gestion des séances</h1>
            <div class="topbar-meta">
              <span class="user-pill user-pill-identity">
                <span id="current-user-name">Utilisateur</span>
                <small id="current-user-public-id">ID : -</small>
              </span>
            </div>
          </div>

          <div class="topbar-actions">
            <button id="add-seance-button" class="button primary" type="button">
              Ajouter
            </button>
            <button id="logout-button" class="button secondary" type="button">
              Déconnexion
            </button>
          </div>
        </header>

        <nav class="workspace-nav panel">
          <button class="nav-tab hidden" type="button" data-section-target="aujourdhui">
            Aujourd'hui
          </button>
          <button class="nav-tab" type="button" data-section-target="dashboard">
            Dashboard
          </button>
          <button class="nav-tab hidden" type="button" data-section-target="indisponibilites">
            Indisponibilités
          </button>
          <button class="nav-tab hidden" type="button" data-section-target="equipe">
            Équipe <span id="team-request-badge" class="nav-notification-badge hidden">0</span>
          </button>
          <button class="nav-tab" type="button" data-section-target="statistiques">
            Statistiques
          </button>
          <button class="nav-tab hidden" type="button" data-section-target="monetisation">
            Monétisation
          </button>
          <button class="nav-tab" type="button" data-section-target="historique">
            Historique
          </button>
          <button class="nav-tab hidden" type="button" data-section-target="calendrier">
            Calendrier
          </button>
          <button class="nav-tab" type="button" data-section-target="utilisateur">
            <span id="user-nav-label">User admin</span>
            <span id="admin-request-badge" class="nav-notification-badge hidden">0</span>
          </button>
        </nav>

        <section id="aujourdhui-section" class="app-section">
          <section class="panel today-panel">
            <div class="section-heading section-heading-stack">
              <div>
                <h2>Aujourd'hui</h2>
                <p id="today-date-label" class="section-note">-</p>
              </div>
              <span id="today-count" class="history-count">0</span>
            </div>

            <div id="today-list" class="today-agenda"></div>
          </section>
        </section>

        <section id="dashboard-section" class="app-section hidden">
          <section class="panel calendar-panel">
            <div class="section-heading">
              <h2>Dashboard</h2>
            </div>

            <div id="calendar"></div>
          </section>
        </section>

        <section id="indisponibilites-section" class="app-section hidden">
          <section class="panel admin-panel-shell">
            <div class="section-heading section-heading-stack">
              <div>
                <h2>Indisponibilités</h2>
              </div>
            </div>

            <div
              id="unavailability-declaration-panel"
              class="unavailability-workbench-panel"
              data-unavailability-panel="declaration"
            >
              <section class="admin-card unavailability-calendar-card">
                <div class="admin-card-head">
                  <div>
                    <h3 class="user-form-title">Déclaration</h3>
                  </div>
                </div>

                <div id="unavailability-calendar"></div>
              </section>
            </div>
          </section>
        </section>

        <section id="equipe-section" class="app-section hidden">
          <section class="panel admin-panel-shell">
            <div class="section-heading section-heading-stack">
              <div>
                <h2>Équipe</h2>
              </div>
            </div>

            <article class="admin-card admin-directory-card">
              <div class="admin-card-head">
                <div>
                  <h3 class="user-form-title">Demandes en attente</h3>
                </div>
              </div>
              <div id="team-pending-requests" class="admin-user-list"></div>
            </article>

            <article class="admin-card admin-directory-card">
              <div class="admin-card-head">
                <div>
                  <h3 class="user-form-title">Professeurs</h3>
                </div>
              </div>
              <div id="team-list" class="admin-user-list"></div>
            </article>

            <article class="admin-card team-subjects-card">
              <div class="admin-card-head">
                <div>
                  <h3 class="user-form-title">Matières</h3>
                </div>
              </div>
              <form id="team-subject-form" class="team-subject-form">
                <label class="field">
                  <span>Nouvelle matière</span>
                  <input
                    id="team-subject-input"
                    type="text"
                    maxlength="80"
                    placeholder="Ex. Mathématiques"
                    autocomplete="off"
                    required
                  />
                </label>
                <button id="team-subject-add-button" class="button primary" type="submit">
                  Ajouter
                </button>
              </form>
              <div id="team-subject-list" class="team-subject-list"></div>
            </article>

            <article class="admin-card team-tarification-card">
              <div class="admin-card-head">
                <div>
                  <h3 class="user-form-title">Tarifs par matière</h3>
                </div>
              </div>
              <form id="team-tarification-form" class="team-tarification-form">
                <div id="team-tarification-table" class="team-tarification-scroll"></div>
                <div class="form-actions team-tarification-actions">
                  <button id="team-tarification-save-button" class="button primary" type="submit">
                    Enregistrer les tarifs
                  </button>
                </div>
              </form>
            </article>
          </section>
        </section>

        <section id="statistiques-section" class="app-section hidden">
          <section class="panel stats-compare-panel statistiques-period-panel">
            <div class="section-heading section-heading-stack">
              <div>
                <h2>Statistiques</h2>
              </div>
            </div>

            <form id="stats-filter-form" class="stack-form" novalidate>
              <div class="form-grid">
                <label class="field">
                  <span>De</span>
                  <input id="stats-date-start" type="date" required />
                </label>
                <label class="field">
                  <span>À</span>
                  <input id="stats-date-end" type="date" required />
                </label>
              </div>

              <label class="stats-global-toggle" for="stats-global-toggle">
                <input id="stats-global-toggle" type="checkbox" />
                <span>Statistiques globales</span>
              </label>

              <p id="stats-filter-error" class="form-error hidden"></p>

              <div class="form-actions">
                <button id="stats-calculate-button" class="button primary" type="submit">
                  Calculer
                </button>
              </div>
            </form>
          </section>

          <section
            id="stats-results"
            class="stats-results hidden"
            aria-live="polite"
            hidden
            inert
          >
            <div id="stats-accounts-overview" class="statistics-overview-grid">
              <article class="panel stat-overview-card stat-overview-card-primary">
                <span class="stat-overview-label">Total général</span>
                <strong id="total-count" class="stat-overview-value">0</strong>
              </article>
            </div>

            <section class="panel stats-compare-panel">
              <div class="section-heading section-heading-stack">
                <div>
                  <h2>Comparatif par réalisateur</h2>
                </div>
              </div>

              <div id="stats-accounts-table" class="stats-table"></div>
            </section>
          </section>
        </section>

        <section id="calendrier-section" class="app-section hidden">
          <section id="calendar-settings-panel" class="panel admin-panel-shell">
            <article id="workspace-settings-card" class="admin-card user-notifications-card">
              <div class="admin-card-head">
                <div>
                  <h3 class="user-form-title">Calendrier</h3>
                </div>
              </div>

              <div class="admin-card-body stack-form">
                <form id="workspace-settings-form" class="stack-form" novalidate>
                  <div>
                    <h4 class="user-form-title">Dashboard</h4>
                  </div>
                  <div class="form-grid">
                    <label class="field">
                      <span>Début de journée</span>
                      <input id="calendar-start-time" type="time" min="00:00" max="23:30" step="1800" required />
                    </label>
                    <label class="field">
                      <span>Fin de journée</span>
                      <input id="calendar-end-time" type="time" min="00:00" max="23:30" step="1800" required />
                    </label>
                  </div>
                  <p id="workspace-settings-error" class="form-error hidden"></p>
                  <div class="form-actions">
                    <button id="workspace-settings-button" class="button primary" type="submit">
                      Enregistrer les paramètres
                    </button>
                  </div>
                </form>

                <section id="public-calendar-settings" class="workspace-public-calendar hidden">
                  <div>
                    <h4 class="user-form-title">Calendrier public</h4>
                  </div>
                  <div class="admin-identity-stats">
                    <div class="admin-identity-stat">
                      <span>Calendrier public</span>
                      <strong id="public-calendar-status">-</strong>
                    </div>
                  </div>

                  <form id="public-calendar-timezone-form" class="stack-form" novalidate>
                    <label class="field">
                      <span>Décalage affiché aux clients</span>
                      <select id="public-calendar-timezone" required>
                        <option value="GMT+1">GMT+1 — horloge centrale + 1 h</option>
                        <option value="GMT+2">GMT+2 — horloge centrale + 2 h</option>
                        <option value="GMT+3">GMT+3 — horloge centrale + 3 h</option>
                        <option value="GMT+4">GMT+4 — horloge centrale + 4 h</option>
                      </select>
                    </label>
                    <p id="public-calendar-timezone-error" class="form-error hidden"></p>
                    <div class="form-actions">
                      <button id="public-calendar-timezone-button" class="button primary" type="submit">
                        Enregistrer
                      </button>
                    </div>
                  </form>

                  <label class="field">
                    <span>Lien public</span>
                    <input id="public-calendar-link" type="url" readonly value="" />
                  </label>

                  <div class="form-actions">
                    <button id="public-calendar-toggle-button" class="button secondary" type="button">
                      Désactiver le lien
                    </button>
                    <button id="public-calendar-copy-button" class="button secondary" type="button">
                      Copier le lien
                    </button>
                  </div>
                </section>
              </div>
            </article>
          </section>
        </section>

        <section id="utilisateur-section" class="app-section hidden">
          <section class="panel admin-panel-shell">
            <div class="section-heading section-heading-stack">
              <div>
                <h2 id="admin-panel-title">User admin</h2>
              </div>
            </div>

            <section class="admin-overview-strip">
              <article class="admin-identity-card">
                <div class="admin-identity-head">
                  <div>
                    <span class="summary-label">Compte connecté</span>
                    <strong id="user-username" class="summary-value user-summary-value">-</strong>
                  </div>

                  <div class="admin-identity-badges">
                    <span id="user-role-badge" class="admin-status-badge">
                      User
                    </span>
                    <span
                      id="user-access-badge"
                      class="admin-status-badge admin-status-badge-active"
                    >
                      Actif
                    </span>
                  </div>
                </div>

                <p id="user-security-status" class="user-security-status">Compte sécurisé.</p>

                <div class="admin-identity-stats">
                  <div class="admin-identity-stat">
                    <span>Outils sensibles</span>
                    <strong id="user-admin-access">Non</strong>
                  </div>
                  <div class="admin-identity-stat">
                    <span>Dernière connexion</span>
                    <strong id="user-last-login">-</strong>
                  </div>
                </div>
              </article>

              <article class="admin-guide-card">
                <span class="summary-label">Vue rapide</span>
                <strong id="admin-guide-title" class="admin-guide-title">Sécurité et contrôle</strong>
              </article>
            </section>

            <div class="admin-panel-layout">
              <form
                id="user-password-form"
                class="stack-form user-password-form admin-card admin-password-card"
                data-admin-group="password"
              >
                <div class="admin-card-head">
                  <div>
                    <h3 class="user-form-title">Sécurité du compte</h3>
                  </div>
                </div>

                <div class="admin-card-body stack-form">
                  <div id="password-security-notice" class="security-notice hidden">
                    Changez le mot de passe maintenant pour débloquer l'application.
                  </div>

                  <label class="field">
                    <span>Mot de passe actuel</span>
                    <input
                      id="current-password"
                      name="mot_de_passe_actuel"
                      type="password"
                      autocomplete="current-password"
                      required
                    />
                  </label>

                  <label class="field">
                    <span>Nouveau mot de passe</span>
                    <input
                      id="new-password"
                      name="nouveau_mot_de_passe"
                      type="password"
                      minlength="12"
                      autocomplete="new-password"
                      required
                    />
                  </label>

                  <label class="field">
                    <span>Confirmer le nouveau mot de passe</span>
                    <input
                      id="confirm-password"
                      name="confirmation_mot_de_passe"
                      type="password"
                      minlength="12"
                      autocomplete="new-password"
                      required
                    />
                  </label>

                  <p id="user-password-error" class="form-error hidden"></p>

                  <div class="form-actions">
                    <button id="save-password-button" class="button primary" type="submit">
                      Modifier le mot de passe
                    </button>
                  </div>
                </div>
              </form>

              <section id="admin-tools-panel" class="user-admin-shell hidden">
                <nav class="admin-workbench-nav" aria-label="Navigation admin">
                  <button
                    class="admin-workbench-tab is-active"
                    type="button"
                    data-admin-view="accounts"
                    aria-selected="true"
                  >
                    Comptes
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="catalogue">
                    Catalogue
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="access">
                    Accès
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="analytics">
                    Analyses
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="security">
                    Sécurité
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="password">
                    MDP
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="notifications">
                    Notifications
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="maintenance">
                    Maintenance
                  </button>
                  <button class="admin-workbench-tab" type="button" data-admin-view="danger">
                    Zone critique
                  </button>
                </nav>

                <article class="admin-card admin-directory-card" data-admin-group="accounts">
                  <div class="admin-card-head">
                    <div>
                      <h3 class="user-form-title">Utilisateurs</h3>
                    </div>
                  </div>

                  <div class="admin-summary-strip">
                    <div class="admin-summary-tile">
                      <span>Total comptes</span>
                      <strong id="admin-total-users">0</strong>
                    </div>
                    <div class="admin-summary-tile">
                      <span>Actifs</span>
                      <strong id="admin-active-users">0</strong>
                    </div>
                    <div class="admin-summary-tile">
                      <span>Lecture seule</span>
                      <strong id="admin-readonly-users">0</strong>
                    </div>
                    <div class="admin-summary-tile">
                      <span>Sessions actives</span>
                      <strong id="admin-active-sessions">0</strong>
                    </div>
                  </div>

                  <div id="admin-users-list" class="admin-user-list"></div>
                </article>

                <article class="admin-card admin-directory-card" data-admin-group="accounts">
                  <div class="admin-card-head">
                    <div>
                      <h3 class="user-form-title">Demandes de comptes</h3>
                    </div>
                  </div>
                  <div id="admin-account-requests-list" class="admin-user-list"></div>
                </article>

                <article class="admin-card admin-global-analytics-card" data-admin-group="analytics">
                  <div class="admin-card-head">
                    <div>
                      <h3 class="user-form-title">Analyses globales</h3>
                    </div>
                  </div>

                  <form id="admin-global-analytics-form" class="admin-analytics-filter" novalidate>
                    <label class="field">
                      <span>Du</span>
                      <input id="admin-global-analytics-du" type="date" />
                    </label>
                    <label class="field">
                      <span>Au</span>
                      <input id="admin-global-analytics-au" type="date" />
                    </label>
                    <div class="form-actions">
                      <button id="admin-global-analytics-button" class="button primary" type="submit">
                        Actualiser
                      </button>
                    </div>
                  </form>
                  <p id="admin-global-analytics-error" class="form-error hidden"></p>

                  <section id="admin-global-analytics-results" class="hidden" aria-live="polite">
                    <div class="admin-summary-strip">
                      <div class="admin-summary-tile">
                        <span>Séances</span>
                        <strong id="admin-global-analytics-total">0</strong>
                      </div>
                      <div class="admin-summary-tile">
                        <span>Faites</span>
                        <strong id="admin-global-analytics-faites">0</strong>
                      </div>
                      <div class="admin-summary-tile">
                        <span>Heures</span>
                        <strong id="admin-global-analytics-heures">0</strong>
                      </div>
                      <div class="admin-summary-tile">
