# Copy this file to .env on the server, then replace every example value.
# Never commit the resulting .env file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Set this to true only behind a reverse proxy you operate yourself.
TRUST_PROXY=true
DATABASE_PATH=/var/lib/gestion-seances/database.db

# Required only for a brand-new database containing no user.
INITIAL_SUPERADMIN_NAME=Administrateur
INITIAL_SUPERADMIN_EMAIL=admin@example.com
INITIAL_SUPERADMIN_PASSWORD=replace-with-a-strong-one-time-password

# Public HTTPS address used in activation and password-reset emails.
ACCOUNT_LIFECYCLE_APP_URL=https://planning.example.com/
ACCOUNT_EMAIL_FROM="Gestion des séances <no-reply@example.com>"
ACCOUNT_EMAIL_DRY_RUN=false
ACCOUNT_ACTIVATION_TOKEN_TTL_MINUTES=1440
# Never set this above 15: reset links are deliberately single-use and short-lived.
ACCOUNT_RESET_PASSWORD_TOKEN_TTL_MINUTES=15

# SMTP account capable of sending email from ACCOUNT_EMAIL_FROM.
# Use 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
# (implicit TLS). Do not leave SMTP_PORT blank or use a textual placeholder.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-an-app-password

# Web Push. Store both keys in the deployment secret manager. If absent, the
# application creates database/.push-vapid-keys.json, which must then persist.
PUSH_VAPID_SUBJECT=mailto:admin@example.com
PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
PUSH_ENABLE_IN_MEMORY_REMINDERS=true
PUSH_REMINDER_TIMEZONE=Africa/Casablanca

# In BACKUP_SEANCES_TIMEZONE: active Handlers receive their scoped CSV at
# 00:00; active SuperAdmins receive the global CSV at 00:00 and 12:00.
# Recipients come from account emails. This is not a full database backup.
BACKUP_SEANCES_ENABLED=true
BACKUP_SEANCES_EMAIL_FROM="Gestion des séances <no-reply@example.com>"
BACKUP_SEANCES_TIMEZONE=Africa/Casablanca
BACKUP_SEANCES_DELIVERY_RETENTION_DAYS=180
BACKUP_SEANCES_EMAIL_DRY_RUN=false

# Central authenticated calendar reference. Public handlers choose a separate
# fixed display offset in the application.
CENTRAL_CALENDAR_TIMEZONE=Africa/Casablanca
CENTRAL_CALENDAR_TIMEZONE_LABEL="heure du Maroc"

# Generate strong, unique values in the deployment secret manager. In
# production, explicitly configured values shorter than 32 bytes or starting
# with a placeholder such as "replace-" are rejected at startup. They must
# remain stable across restarts so signed sessions and public links stay valid.
SESSION_SECRET=replace-with-a-long-random-secret
AUDIT_SECRET=replace-with-a-long-random-secret
